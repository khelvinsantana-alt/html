            </div>


        </div>

    </section>


    <!-- GALERIA -->

    <section id="galeria">

        <div class="section-title reveal">

            <small>03 / Lifestyle</small>

            <h2>
                O luxo em movimento.
            </h2>

        </div>


        <div class="gallery">

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1200&q=85">
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1558980394-0c5e4d7a0b2d?auto=format&fit=crop&w=900&q=85">
            </div>

            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=900&q=85">
